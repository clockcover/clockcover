{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/no-ai-coauthor.ts",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node .claude/hooks/destructive-git.ts",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/synthetic-only.ts",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
