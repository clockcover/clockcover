// Cloudflare Workers config (ADR-0001). Secrets (LINK_SECRET, RESEND_API_KEY) are set
// with `wrangler secret put`, never here; locally they live in .dev.vars (gitignored).
// Upload API keys are per employer and live in D1 (api_keys), issued from the console.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clockcover-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "routes": [{ "pattern": "api.clockcover.com", "custom_domain": true }],
  "triggers": {
    // Daily imports, digests and escalations at 08:00 UTC; each employer's dates and the
    // SLA are computed in its own timezone (employers.timezone).
    "crons": ["0 8 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clockcover",
      // Created with `wrangler d1 create clockcover`.
      "database_id": "ca1b818a-21e2-4896-b8c5-2e923887a1f9",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "EMAIL_FROM": "ClockCover <digest@clockcover.com>",
    "WEB_URL": "https://portal.clockcover.com",
    "CONSOLE_URL": "https://console.clockcover.com",
    "ADMIN_URL": "https://admin.clockcover.com",
    "ADMIN_EMAIL": "andrew@molyuk.com",
    "SITE_URLS": "https://clockcover.com,https://www.clockcover.com",
    "CONTACT_EMAIL": "hello@clockcover.com",
    "SLA_HOURS": "48"
  }
}
