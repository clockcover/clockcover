{
  "name": "@clockcover/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply clockcover --local",
    "db:migrate:remote": "wrangler d1 migrations apply clockcover --remote"
  },
  "dependencies": {
    "@clockcover/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@libsql/client": "^0.17.4",
    "@types/node": "^26.2.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "wrangler": "^4.125.0"
  }
}
