// Static marketing site served as Worker assets — no code, no data, no bindings.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clockcover-site",
  "compatibility_date": "2026-08-01",
  "routes": [
    { "pattern": "clockcover.com", "custom_domain": true },
    { "pattern": "www.clockcover.com", "custom_domain": true }
  ],
  "assets": { "directory": "./public", "not_found_handling": "404-page" }
}
