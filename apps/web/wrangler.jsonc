// The digest page as static Worker assets. `/d/<token>` is handled client-side,
// so every unknown path serves index.html. Build first: VITE_API_URL=<api origin> pnpm build
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clockcover-web",
  "compatibility_date": "2026-08-01",
  "routes": [
    { "pattern": "digest.clockcover.com", "custom_domain": true }, // managers: /d/<token>
    { "pattern": "app.clockcover.com", "custom_domain": true } // operators: /console
  ],
  "assets": { "directory": "./dist", "not_found_handling": "single-page-application" }
}
